server {
    listen ${NGINX_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Serve the SPA.
    location / {
        try_files $uri /index.html;
    }

    # Proxy API calls to the API service. API_UPSTREAM defaults to the compose
    # service (http://api:8080); set it to the API's public origin when the UI
    # and API are hosted as separate services (e.g. https://my-api.onrender.com).
    #
    # The upstream is assigned to a variable with a DNS resolver so nginx resolves
    # it at request time instead of refusing to start when the host isn't yet
    # resolvable at boot. DNS_RESOLVER defaults to a public resolver (works on
    # Render / most hosts); for docker-compose set it to Docker's embedded DNS
    # 127.0.0.11 so the internal "api" service name resolves.
    location /api/ {
        resolver ${DNS_RESOLVER} ipv6=off valid=30s;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream/api/;

        # When the upstream is a public HTTPS origin, use its own host for SNI,
        # the Host header, and certificate validation.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
